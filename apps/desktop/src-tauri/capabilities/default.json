{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Quill settings, recording, and Scribe review windows",
  "windows": ["main", "overlay", "scribe-overlay", "scribe-review"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "shell:allow-open",
    "updater:default",
    "autostart:default"
  ]
}
